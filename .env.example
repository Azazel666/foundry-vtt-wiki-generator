# Copy to .env. See section 10 of the Implementation Specification for every setting.

# Local dev: each env's Foundry Data folder, mounted read-only. The env list itself is in compose.yaml.
FOUNDRY_MAIN_DATA=D:/FoundryVTT/Data/Data_v13/Data
FOUNDRY_CANARY_DATA=D:/FoundryVTT/Data/Data_v14/Data

WIKI_SITE_URL=http://localhost:8000
# Host port for the local nginx
# WIKI_LOCAL_PORT=8000
TZ=Europe/Stockholm

# AI summaries. Set WIKI_LLM_ENABLED=true and the password to use the GPU node's conductor.
WIKI_LLM_ENABLED=false
REDIS_HOST=192.168.3.20
VRAM_REDIS_PASSWORD=

# Optional, read-only public access. Strongly recommended for the first run.
GITHUB_TOKEN=
